# Pinned build tool versions: the one place to change them.
# Read by .github/workflows/deploy.yml, .github/workflows/update-theme.yml
# and .tugboat/config.yml. Keep plain KEY=VALUE lines (no quotes or spaces)
# so the file works both as a shell script and as a $GITHUB_ENV file.
# To upgrade, run the "Update theme" workflow by hand, or edit these values.
HUGO_VERSION=0.161.1
DART_SASS_VERSION=1.97.1
GO_VERSION=1.25.7
